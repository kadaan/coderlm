{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-init.sh\"",
            "timeout": 10000,
            "description": "Check if coderlm-server is running, auto-create session"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-stop.sh\"",
            "timeout": 5000,
            "description": "Clean up coderlm session"
          }
        ]
      }
    ]
  }
}